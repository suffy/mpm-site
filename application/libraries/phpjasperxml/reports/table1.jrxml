	<subDataset name="ds2">
		<parameter name="pp" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="p1" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="p2" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT
     digi_cso.`contractType` AS digi_cso_contractType,
	count(*) as contractqty
FROM
     `digi_cso` digi_cso
where digi_cso.`contractType` LIKE '$P{pp}'
order by   digi_cso.`contractType`]]>
		</queryString>
		<field name="digi_cso_contractType" class="java.lang.String"/>
		<field name="contractqty" class="java.lang.Long"/>
		<group name="digi_cso_contractType">
			<groupExpression><![CDATA[$F{digi_cso_contractType}]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="ds3">
		<queryString>
			<![CDATA[SELECT
     digi_cso.`contractType` AS digi_cso_contractType,
    count( digi_cso.`bpartner_id`) AS digi,
    avg( digi_cso.`bpartner_id`) AS digi2,
    avg( digi_cso.`bpartner_id`+4) AS digi3

FROM
     `digi_cso` digi_cso
group by    digi_cso.`contractType`]]>
		</queryString>
		<field name="digi_cso_contractType" class="java.lang.String"/>
		<field name="digi" class="java.lang.Long"/>
		<field name="digi2" class="java.lang.Double"/>
		<field name="digi3" class="java.lang.Double"/>
		<group name="digi">
			<groupExpression><![CDATA[$F{digi}]]></groupExpression>
		</group>
	</subDataset>
	<queryString>
		<![CDATA[select agreeType,count(*) as qty from digi_agreement
group by agreeType]]>
	</queryString>
	<field name="agreeType" class="java.lang.String"/>
	<field name="qty" class="java.lang.Long"/>
	<variable name="TOTAL" class="java.lang.Number">
		<variableExpression><![CDATA[$F{qty}]]></variableExpression>
	</variable>
